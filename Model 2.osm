  <tag k="description" v="A 978 mile / 1573 km route from Rievaulx Abbey in North Yorkshire, England to Citeaux Abbey, south of Dijon in France."/>
  <tag k="distance" v="1573"/>
  <tag k="name" v="St Bernard's Way"/>
  <tag k="network" v="iwn"/>
  <tag k="note" v="Route is not marked or signposted in any way. Site indicates that route is to follow other paths, mainly the Via Francigena. Route set to historic, but should likely be removed completely."/>
  <tag k="route" v="historic"/>
  <tag k="type" v="route"/>
  <tag k="website" v="http://www.abbeywalks.co.uk/walks/stbernardsway"/>
 </relation>
