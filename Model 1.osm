  <tag k="name" v="St Bernard's Way"/>
  <tag k="network" v="iwn"/>
  <tag k="note" v="Route is not marked or signposted in any way. Site indicates that route is to follow other paths, mainly the Via Francigena. Route set to historic, but should likely be removed completely."/>
